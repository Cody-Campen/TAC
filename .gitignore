# LaTeX build intermediates
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.synctex.gz
*.toc

# endfloat (tables/figures held for the end of the manuscript)
*.fff
*.ttt

# latexmk aux directory
build/

# other junk
.claude/*
!.claude/settings.json
.vscode

# simulation study outputs (regenerated by run_jobs.sh / aggregate_results.R)
simulation/results/
simulation/logs/

# empirical data: the real dataset lives OUTSIDE this repo entirely (see
# empirical/README.md); this just covers the local cache of derived
# output and the file that points at the real data's location.
# Only empirical/tables/ and empirical/figures/ (aggregated outputs) are tracked.
empirical/data/processed/
empirical/config/data_path.local.txt
empirical/logs/