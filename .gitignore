# LaTeX build intermediates
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.synctex.gz
*.toc

# endfloat (tables/figures held for the end of the manuscript)
*.fff
*.ttt

# latexmk build directory (aux files + PDF + synctex)
.build/

# other junk
.claude
.vscode
.documents

# simulation study outputs (regenerated by run_jobs.sh / simulation/main.R)
simulation/results/
simulation/logs/

# empirical data info
empirical/data/processed/
empirical/config/data_path.local.txt
empirical/logs/
# dynr writes and compiles a C file per model fit
.dynrtmp/
dynrtmp/

# recovery plots written by the test suite
tests/testthat/figures/

# make_notation.py leaves these behind when imported for testing
__pycache__/
