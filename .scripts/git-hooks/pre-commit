#!/bin/sh
# Backstop against ever committing empirical data, even via `git add -f`.
# Install: cp scripts/git-hooks/pre-commit .git/hooks/pre-commit
#          chmod +x .git/hooks/pre-commit

forbidden=$(git diff --cached --name-only | grep -E \
  '^empirical/data/(processed|raw)/|^empirical/config/data_path\.local\.txt$')

if [ -n "$forbidden" ]; then
  echo "BLOCKED: staged file(s) look like empirical data, not committing:" >&2
  echo "$forbidden" >&2
  echo "If this is a false positive, unstage it or edit scripts/git-hooks/pre-commit." >&2
  exit 1
fi

exit 0
